# ================================
# Enterprise Intelligent Platform
# Backend Environment Variables
# ================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# MONGODB_URI=mongodb://localhost:27017/enterprise-platform
# For MongoDB Atlas:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/enterprise-platform
# Boot connectivity retries — helps survive Atlas M0 free-tier pause/resume
# (can take 30-120s to elect a primary). The server retries before giving up.
DB_RETRY_ATTEMPTS=6
DB_RETRY_DELAY_MS=15000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Groq AI
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here
# Supported models: llama-3.3-70b-versatile, llama-3.1-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile
# Note: Groq does not support embeddings — mock zero-vectors are used automatically
EMBEDDING_MODEL=text-embedding-3-large

# Client (for CORS) — comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173

# Optional. When set, this exact directory is served as the frontend build
# (SPA with deep-link fallback). Defaults to <repo>/frontend/dist — enabled
# automatically in production hosting when that directory exists.
# FRONTEND_DIST=../frontend/dist

# File Upload
MAX_FILE_SIZE_MB=100000
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# MongoDB Atlas Vector Search (optional — required for production vector search)
VECTOR_SEARCH_INDEX_NAME=enterprise_vector_index
VECTOR_DIMENSIONS=3072

# Email domain restriction (login/registration)
# (removed — signup now requires Gmail addresses, enforced in code)

# Contact / Resend Email — Gmail Deliverability
# RESEND_FROM_EMAIL must be a verified sender/domain in Resend (resend.com/domains).
# In test mode without a verified domain, use onboarding@resend.dev — but it can ONLY send to your Resend account email (check Resend dashboard) or delivered@resend.dev.
# To send to any Gmail, verify your domain (configure SPF/DKIM/DMARC as shown by Resend) and set RESEND_FROM_EMAIL to you@verifieddomain.com
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=verified@yourdomain.com
ADMIN_EMAIL=admin@example.com
# Example for current test account without verified domain:
# RESEND_FROM_EMAIL=onboarding@resend.dev
# ADMIN_EMAIL=harieshvenkatachalam@gmail.com  # must be your Resend account email until domain verified
# Optional: contact endpoint rate limiting (5 requests per 15 min by default)
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=10000

# Gmail SMTP — used ONLY for user Sign In OTP delivery.
# Do NOT use these for admin authentication, and keep Resend for the Contact page only.
# To send from Gmail you must enable 2-Step Verification and create an App Password:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_gmail_address@gmail.com
# OTP security (reasonable controls — NOT a daily/monthly login limit)
OTP_EXPIRES_MINUTES=20
OTP_MAX_ATTEMPTS=20

# Admin Report Upload
ADMIN_REPORT_UPLOAD_DIR=./uploads/reports
